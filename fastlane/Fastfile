require 'shellwords'

default_platform :mac

platform :mac do

  ############################ PRE ############################

  before_all do
  end

  ######################## SETUP LANES ########################

  desc "Setup development"
  lane :setup do
  end

  desc "Setup release developer id account settings. (only use admin)"
  lane :setup_release_id do
    # Update Project Team
    update_project_team(
      path: "Clipy.xcodeproj",
      teamid: "BBCHAJ584H"
    )
    # Update Provisioning Profile
    update_provisioning_profile_specifier(
      xcodeproj: "Clipy.xcodeproj",
      new_specifier: "ClipyDistribution",
      configuration: "Release",
      target: "^Clipy$"
    )
  end

  ####################### PUBLIC LANES ########################

  desc "Runs all the tests"
  lane :test do
    scan_clipy
  end
  
  desc "Release"
  lane :release do
    # TODO: Use :codesigning_identity options (Developer ID Application: Shunsuke Furubayashi (BBCHAJ584H))
    # TODO: Use :export_method options (developer-id)
  end

  desc "Build a local Apple Silicon app without Sparkle auto updates"
  lane :build_local do
    ENV["DEVELOPER_DIR"] ||= "/Applications/Xcode.app/Contents/Developer" if File.directory?("/Applications/Xcode.app/Contents/Developer")

    derived_data_path = "build/local-arm64/DerivedData"
    app_path = "#{derived_data_path}/Build/Products/Release/Clipy.app"

    sh(%(xcodebuild -project Clipy.xcodeproj -scheme Clipy -configuration Release -destination 'platform=macOS,arch=arm64' -derivedDataPath #{derived_data_path.shellescape} -skipPackagePluginValidation ARCHS=arm64 ONLY_ACTIVE_ARCH=YES OTHER_SWIFT_FLAGS='$(inherited) -D LOCAL_ARM_BUILD' build))
    verify_arm64_app(app_path: app_path)
  end

  ####################### PRIVATE LANES ########################

  private_lane :scan_clipy do
    scan(
      project: "Clipy.xcodeproj",
      scheme: "Clipy",
      skip_build: true,
      verbose: true,
      clean: true,
      xcargs: "-skipPackagePluginValidation"
    )
  end

  private_lane :verify_arm64_app do |options|
    app_path = options[:app_path]
    UI.user_error!("App bundle not found: #{app_path}") unless File.directory?(app_path)

    checked = 0
    missing = []
    Dir.glob(File.join(app_path, "**", "*"), File::FNM_DOTMATCH).each do |path|
      next unless File.file?(path)

      description = `file #{Shellwords.escape(path)}`
      next unless description.include?("Mach-O")

      checked += 1
      archs = `lipo -archs #{Shellwords.escape(path)}`.strip
      UI.message("#{path}: #{archs}")
      missing << "#{path} (#{archs})" unless archs.split.include?("arm64")
    end

    UI.user_error!("No Mach-O binaries found under #{app_path}") if checked.zero?
    UI.user_error!("Missing arm64 slice:\n#{missing.join("\n")}") unless missing.empty?
  end

  ############################ POST ############################

  after_all do |lane|
  end

  error do |lane, exception|
  end
end
